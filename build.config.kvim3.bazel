. ${ROOT_DIR}/${KERNEL_DIR}/build.config.gki.aarch64

export COMMON_DRIVERS_DIR=common_drivers

# Mali Bifrost GPU driver version. The A311D has a Mali-G52, not the VIM3L's
# G31, but GPU_TYPE is only a label here - the bifrost Makefile never reads it,
# and the same r47p0 midgard source serves both. Override its default r25p0.
export GPU_DRV_VERSION=r44p1
export GPU_TYPE=dvalin
export GPU_ARCH=bifrost

export DTC_INCLUDE="${ROOT_DIR}/${KERNEL_DIR}/../common_drivers/include"

DEFCONFIG=amlogic_gki_defconfig

function pre_defconfig_cmds() {
	KCONFIG_DEFCONFIG=${KERNEL_DIR}/arch/arm64/configs/${DEFCONFIG}
	local temp_file=`mktemp /tmp/config.XXXXXXXXXXXX`

	echo "" > ${temp_file}

	KCONFIG_CONFIG=${KCONFIG_DEFCONFIG} ${ROOT_DIR}/${KERNEL_DIR}/scripts/kconfig/merge_config.sh -m -r \
			${ROOT_DIR}/${KERNEL_DIR}/arch/arm64/configs/gki_defconfig \
			${ROOT_DIR}/${KERNEL_DIR}/../common_drivers/arch/arm64/configs/amlogic_gki.fragment \
			${ROOT_DIR}/${KERNEL_DIR}/../common_drivers/arch/arm64/configs/amlogic_gki.10 \
			${ROOT_DIR}/${KERNEL_DIR}/../common_drivers/arch/arm64/configs/amlogic_gki.debug \
			${ROOT_DIR}/${KERNEL_DIR}/../common_drivers/arch/arm64/configs/amlogic_upgrade_u.defconfig \
			${ROOT_DIR}/${KERNEL_DIR}/../common_drivers/arch/arm64/configs/kvim3_devconfig \
			${temp_file}

	rm ${temp_file}
}
export -f pre_defconfig_cmds
PRE_DEFCONFIG_CMDS=pre_defconfig_cmds

function post_defconfig_cmds() {
	rm -f ${ROOT_DIR}/${KERNEL_DIR}/arch/arm64/configs/${DEFCONFIG}
}
export -f post_defconfig_cmds
POST_DEFCONFIG_CMDS=post_defconfig_cmds

KMI_SYMBOL_LIST=android/abi_gki_aarch64_amlogic
